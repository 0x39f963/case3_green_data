# Пример переменных окружения для локальной разработки.
# Скопировать в .env и заполнить значения. Файл .env в git не попадает.

# ---------------------------------------------------------------------------
# Выбор контура языковой модели.
#
# LLM_MODE определяет, к какому бэкенду идут вызовы.
# Поддерживаемые значения:
#   dev_local    - обе роли через CLI claude
#   prod_demo    - обе роли через OpenRouter
#   mixed        - генератор через OpenRouter, аудитор через CLI claude
#   local_openai - локальная модель (Ollama, vLLM, LM Studio, text-generation-webui)
#                  с OpenAI-совместимой ручкой /v1/chat/completions
# ---------------------------------------------------------------------------
LLM_MODE=prod_demo

# Имена моделей по ролям. LLM_GENERATOR_MODEL выбирает один из трех
# генераторных профилей B3 и сам задает провайдера генератора.
# LLM_MODEL_AUDITOR оставлен как прямой override модели аудитора.
LLM_GENERATOR_MODEL=qwen3-5-9b
# LLM_GENERATOR_MODEL=qwen3-coder-30b-a3b
# LLM_GENERATOR_MODEL=qwen3-235b-a22b-2507
# LLM_GENERATOR_MODEL=qwen3-32b
# LLM_GENERATOR_MODEL=gpt-5-4-mini
# LLM_GENERATOR_MODEL=kimi-k2-6
# LLM_GENERATOR_MODEL=gpt-5-4-nano
# LLM_GENERATOR_MODEL=gemini-3-1-flash-lite
# LLM_GENERATOR_MODEL=claude-haiku-4-5
# Если вручную задан LLM_BACKEND_GENERATOR, можно явно указать модель:
# LLM_MODEL_GENERATOR=qwen2.5-coder:14b
LLM_MODEL_AUDITOR=qwen2.5:14b
LLM_MULTI_CANDIDATE=true
LLM_PARALLEL_CANDIDATES=true
LLM_GENERATOR_TEMPERATURES=0.5,0.8
GENERATOR_TOOL_MODE=false
GENERATOR_TOOL_MAX_STEPS=5
STAGE_3_ENABLED=true
STAGE_4_ENABLED=true
STAGE_4_BACKEND=openrouter-gemini-3.1-flash
PROMPT_CHECK_LLM_ENABLED=true
PROMPT_CHECK_LLM_BACKEND=local_openai
PROMPT_CHECK_LLM_MODEL=qwen3:8b
# CLASSIFIER_ENCODER_PATH=app/classifier/models/encoder_v1_0
MAX_ITERATIONS=5

# Таймаут одного вызова провайдера. API-слой отдельно держит общий
# latency budget для оркестратора SQL Security Pipeline.
# Soft = предупреждение в trace; Hard = жесткий timeout с 504.
# Docker app использует те же значения (см. deploy/docker-compose.yml).
LLM_CALL_TIMEOUT_SEC=300
LATENCY_SOFT_SEC=300
LATENCY_HARD_SEC=600

# ---------------------------------------------------------------------------
# Настройки OpenRouter (LLM_MODE=openrouter)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Настройки локальной OpenAI-совместимой модели (LLM_MODE=local_openai)
# Канонический endpoint для Docker runtime - host-published Ollama port.
# Для host-only CLI smoke можно отдельно задать HOST_LOCAL_LLM_BASE_URL.
# ---------------------------------------------------------------------------
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
HOST_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=not-needed
LOCAL_LLM_TEST_MODEL=qwen3:8b
LOCAL_LLM_USE_NATIVE_OLLAMA=true
OLLAMA_REQUEST_KEEP_ALIVE=30s
OLLAMA_KEEP_ALIVE=30s

# ---------------------------------------------------------------------------
# Настройки CLI-бэкендов. Пути нужны если бинарь лежит не в PATH контейнера.
# ---------------------------------------------------------------------------
ANTHROPIC_CLI_PATH=claude
CODEX_CLI_PATH=codex

# ---------------------------------------------------------------------------
# Подключение к PostgreSQL для песочницы EXPLAIN.
# Имя хоста postgres соответствует имени сервиса в docker-compose.yml.
# ---------------------------------------------------------------------------
POSTGRES_DSN=postgresql://demo:demo@postgres:5432/demo_db
POSTGRES_AUDIT_PASSWORD=audit_ro_password
POSTGRES_AUDIT_DSN=postgresql://audit_ro:audit_ro_password@postgres:5432/demo_db
POSTGRES_PORT=15433
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=demo_db

# ---------------------------------------------------------------------------
# Адрес FastAPI для Streamlit-UI. Внутри Docker - имя сервиса app.
# ---------------------------------------------------------------------------
APP_API_URL=http://app:8000

# Адрес HTML-просмотрщика трасс, на который Streamlit ставит ссылку.
# Внутри docker-сети это http://trace-viewer:8502, с хоста - localhost.
TRACE_VIEWER_URL=http://localhost:8502

# Порты публикации docker-compose на хосте. Можно менять на сервере,
# если 8000/8501/8502 заняты другими сервисами.
APP_PORT=8000
STREAMLIT_PORT=8501
TRACE_VIEWER_PORT=8502

# ---------------------------------------------------------------------------
# Тестовый Telegram-бот. Опционально, для команды.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
BOT_API_URL=http://localhost:8000
BOT_REPORT_DIR=data/bot/reports
BOT_USER_PREFS_PATH=data/bot/user_prefs.json
BOT_MODELS_CONFIG=deploy/bot_models.json
BOT_REPORT_DELIVERY_MODE=local
BOT_PHP_UPLOAD_URL=
BOT_REPORT_UPLOAD_SECRET=
BOT_RUN_TIMEOUT_SEC=660

# ---------------------------------------------------------------------------
# Папка трасс. Туда orchestrator пишет JSON со всеми шагами pipeline.
# trace-viewer читает ее как том только для чтения.
# ---------------------------------------------------------------------------
TRACES_DIR=/app/data/traces
WEB_CHAT_DIR=/app/data/web_chats

# ---------------------------------------------------------------------------
# RAG индексы
# ---------------------------------------------------------------------------
# table_knowledge_v2: бизнес-знания о 60 таблицах схемы (data/rag/v2/).
# Хранится в PostgreSQL benchmark.rag_embeddings(index_name='table_knowledge_v2').
# При true блок "BUSINESS TABLES (v2)" добавляется в get_generation_context.
# Для app-контейнера задавать явно: 127.0.0.1 внутри контейнера не является benchmark_pg.
BENCHMARK_DSN=postgresql://bench:bench@host.docker.internal:15434/bench
TABLE_KNOWLEDGE_V2_ENABLED=false
